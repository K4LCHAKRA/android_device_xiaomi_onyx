# CNE
persist.vendor.cne.feature=1

# Device
ro.product.marketname=POCO F7
ro.product.mod_device=onyx_global

# GPS
persist.backup.ntpServer=0.pool.ntp.org

# HWUI
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.mediaserver.64b.enable=true
ro.media.recorder-max-base-layer-fps=60
ro.media.xml_variant.profiles=_tuna_v0

# QTI
ro.vendor.qti.va_aosp.support=1

# Radio
persist.vendor.data.mode=concurrent
ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1

# WFD
persist.debug.wfd.enable=1

# Add these as PRODUCT_SYSTEM_PROPERTIES (system.prop), You may use utilities as libinit if configuring for unified devices
ro.infinity.soc=Snapdragon 8735
ro.infinity.battery=7550 mAh
ro.infinity.display=1080 x 2400, 60 Hz
ro.infinity.camera=50MP + 8MP + 20MP

# Also declare your Device Name with appropirate sepolicy rule(Take libinit in use if Unified)
ro.product.marketname=POCO F7
